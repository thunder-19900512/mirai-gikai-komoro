<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yamada.mirai-gikai-komoro-keepalive</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/yamadayuji/deploy/mirai-gikai-komoro/komoro/pipeline/keepalive.sh</string>
    </array>
    <!-- Supabase Free の7日無アクセス停止を防ぐ。毎日 12:10（スリープ中なら復帰時に1回実行） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/yamadayuji/deploy/mirai-gikai-komoro/komoro/pipeline/logs/keepalive.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yamadayuji/deploy/mirai-gikai-komoro/komoro/pipeline/logs/keepalive.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
