# みらい議会＠小諸市 自動更新パイプライン用の環境変数（本番投入先）
# このファイルをコピーして pipeline/.env を作る（.env は gitignore 済み）。
# 本番デプロイ後、投入先を本番Supabaseにするために設定する。

# 本番 Supabase のプロジェクトURL
SUPABASE_URL=

# 本番 Supabase の service_role / secret キー（サーバー専用・絶対に公開しない）
SUPABASE_SECRET_KEY=

# 本番 admin のURL（通知メールの「レビューを開く」リンク先）
ADMIN_URL=https://<your-admin>.vercel.app
